        },
        {
          "expr": "ml_anomaly_vicdemand",
          "legendFormat": "VIC Demand",
          "refId": "D"
        },
        {
          "expr": "ml_anomaly_transfer",
          "legendFormat": "Transfer",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
